# Bio Pipeline MCP server configuration.
# Copy to `.env` (next to this file) or set these in the Claude Desktop config
# `env` block. Values set in the real environment always win over the .env file.

# Where the backend HTTP API is reachable. Dev default is port 8006.
BIO_PIPELINE_BASE_URL=http://127.0.0.1:8006

# API route prefix (matches backend `api_prefix`).
BIO_PIPELINE_API_PREFIX=/api/v1

# Credentials the MCP server logs in with. The account's ROLE decides which
# tools work: an admin gets the full surface, a `user` (researcher) only the
# catalog / run / saved-value tools.
BIO_PIPELINE_USERNAME=admin
BIO_PIPELINE_PASSWORD=change-me

# Optional tuning.
BIO_PIPELINE_TIMEOUT=60
BIO_PIPELINE_VERIFY_TLS=true

# --- Streamable-HTTP transport (remote connector for Cowork / claude.ai) ------
# Only used by the `bio-pipeline-mcp-http` entry point; the stdio server ignores
# these. Bind address + port + path the server listens on.
BIO_PIPELINE_MCP_HOST=127.0.0.1
BIO_PIPELINE_MCP_PORT=8765
BIO_PIPELINE_MCP_PATH=/mcp

# Shared-secret bearer token required on every HTTP request (sent as
# `Authorization: Bearer <token>`). REQUIRED to bind any non-loopback interface.
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIO_PIPELINE_MCP_AUTH_TOKEN=

# Stateless mode is friendlier behind brokers/proxies/tunnels (default true).
BIO_PIPELINE_MCP_STATELESS=true

# Escape hatch: allow binding a non-loopback host without a token (NOT advised).
BIO_PIPELINE_MCP_ALLOW_INSECURE=false
