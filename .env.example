# AI provider credentials for the Bio Pipeline Manager AI Designer.
# Copy to .env and fill in the keys for the providers you enable in
# configs/app_config.yaml. Keys are read server-side only and are never
# exposed to the frontend. Do NOT commit a real .env.

# Anthropic / Claude (default provider)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenAI-compatible server (e.g. local or self-hosted)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
